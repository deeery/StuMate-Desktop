{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StuMate Lite",
  "version": "1.7.19",
  "identifier": "com.stumate.lite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "StuMate Lite（Tauri 版）",
    "longDescription": "StuMate Lite 是 StuMate 桌面端的 Tauri 重构版，与原 Compose 版同版本号并存、共用同一份本地数据。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
